/* Independent full64 inputs. Ten controlled GPRs receive cyclic rotations,
 * so every destination sees every value and other GPRs remain canaries. */
V(zero,                0x0000000000000000)
V(one,                 0x0000000000000001)
V(two,                 0x0000000000000002)
V(three,               0x0000000000000003)
V(nibble_last,         0x000000000000000f)
V(nibble_next,         0x0000000000000010)
V(nibble_next_odd,     0x0000000000000011)
V(byte_signed_last,    0x000000000000007f)
V(byte_high,           0x0000000000000080)
V(byte_high_odd,       0x0000000000000081)
V(byte_last,           0x00000000000000ff)
V(byte_next,           0x0000000000000100)
V(byte_next_odd,       0x0000000000000101)
V(word_last,           0x000000000000ffff)
V(word_next,           0x0000000000010000)
V(word_next_odd,       0x0000000000010001)
V(low32_signed_last,   0x000000007fffffff)
V(low32_high,          0x0000000080000000)
V(low32_last,          0x00000000ffffffff)
V(high32_first,        0x0000000100000000)
V(high32_first_odd,    0x0000000100000001)
V(signed_last_even,    0x7ffffffffffffffe)
V(signed_last,         0x7fffffffffffffff)
V(highbit,             0x8000000000000000)
V(highbit_one,         0x8000000000000001)
V(highbit_two,         0x8000000000000002)
V(allones_even,        0xfffffffffffffffe)
V(allones,             0xffffffffffffffff)
V(dirty_alternating,   0xa5a5a5a55a5a5a5a)
V(dirty_alternating_odd,0x5a5a5a5aa5a5a5a5)
V(dirty_high_zero_low, 0xdeadbeef00000000)
V(dirty_high_one_low,  0x1234567800000001)
