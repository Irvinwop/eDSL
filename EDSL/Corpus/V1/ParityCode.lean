import EDSL.Arithmetic64.Parity
import EDSL.X86.VCGen.CompilerComparisons

set_option autoImplicit false
set_option warningAsError true

namespace EDSL.Corpus.V1.ParityCode
open X86

abbrev Compiler := X86.VCGen.CompilerComparisons.Compiler

/-- Complete unchanged row-12 c_parity_loop symbol extents. GCC includes the
original ENDBR64, both RETs and intervening padding; Clang includes its six-byte
NOP. These candidates alone assert no decoding, behavior or loaded authority. -/
def bytes : Compiler → List Byte
  | .defaultGCC =>
      [0xf3,0x0f,0x1e,0xfa,0x31,0xc0,0x48,0x85,0xff,0x74,0x15,
       0x0f,0x1f,0x44,0x00,0x00,0x89,0xfa,0x83,0xe2,0x01,0x31,0xd0,
       0x48,0xd1,0xef,0x75,0xf4,0xc3,0x0f,0x1f,0x00,0xc3]
  | .defaultClang =>
      [0x31,0xc0,0x48,0x85,0xff,0x74,0x1c,0x48,0x89,0xf9,
       0x66,0x0f,0x1f,0x44,0x00,0x00,0x89,0xfa,0x83,0xe2,0x01,
       0x31,0xd0,0x48,0xd1,0xe9,0x48,0x83,0xff,0x01,0x48,0x89,0xcf,
       0x77,0xed,0xc3]

/-- Full64 bit-position cardinality modulo two, returned in unsigned low32. -/
abbrev spec := Arithmetic64.parity64

end EDSL.Corpus.V1.ParityCode
