private theorem first_zero (source : List Byte) (zero : (0 : Byte) ∈ source) :
    source[(source.takeWhile (· != 0)).length]? = some 0 := by
  induction source with
  | nil => simp at zero
  | cons first rest ih =>
    by_cases equal : first = 0
    · simp [equal]
    · have member : (0 : Byte) ∈ rest := by
        rcases List.mem_cons.mp zero with head | tail
        · exact (equal head.symm).elim
        · exact tail
      have condition : (first != (0 : Byte)) = true := bne_iff_ne.mpr equal
      simpa only [List.takeWhile_cons, condition, ↓reduceIte, List.length_cons,
        List.getElem?_cons_succ] using ih member

private theorem terminated_iff_lt (strings : List Byte)
    (last : strings.getLast? = some 0) (offset : Nat) :
    Terminated strings offset ↔ offset < strings.length := by
  constructor
  · exact fun held => held.1
  · intro inside
    refine ⟨inside, ?_⟩
    have finalByte := last
    rw [List.getLast?_eq_getElem?] at finalByte
    have endIndex : offset + (strings.length - 1 - offset) = strings.length - 1 := by omega
    have atEnd : (strings.drop offset)[strings.length - 1 - offset]? = some 0 := by
      rw [List.getElem?_drop, endIndex]
      exact finalByte
    have zero : (0 : Byte) ∈ strings.drop offset := List.mem_of_getElem? atEnd
    simpa only [nameAt, List.getElem?_drop] using first_zero (strings.drop offset) zero

