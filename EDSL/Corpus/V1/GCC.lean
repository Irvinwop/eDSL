-- Proved normalization of the original checker to bounded raw row slices.
private theorem readNat_take {source : List Byte} {size offset width : Nat}
    (inside : offset + width ≤ size) (enough : size ≤ source.length) :
    EDSL.ELF.readNat source offset width =
      EDSL.ELF.readNat (source.take size) offset width := by
  have sourceBound : offset + width ≤ source.length := Nat.le_trans inside enough
  have takeBound : offset + width ≤ (source.take size).length := by
    rw [List.length_take, Nat.min_eq_left enough]
    exact inside
  simp only [EDSL.ELF.readNat, sourceBound, takeBound, ↓reduceIte]
  congr 1
  rw [List.take_drop, List.take_drop, List.take_take, Nat.min_eq_left inside]

local macro "gccTableFields" : term => do
  pure (Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionSymbol 0 ++
    `EDSL.ELF.FunctionSymbol.checkTableFields))
local macro "gccSymbolFields" : term => do
  pure (Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionSymbol 0 ++
    `EDSL.ELF.FunctionSymbol.checkFields))
local macro "unfoldGccTableFields" : tactic => do
  let identifier := Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionSymbol 0 ++
    `EDSL.ELF.FunctionSymbol.checkTableFields)
  `(tactic| unfold $identifier:ident)
local macro "unfoldGccSymbolFields" : tactic => do
  let identifier := Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionSymbol 0 ++
    `EDSL.ELF.FunctionSymbol.checkFields)
  `(tactic| unfold $identifier:ident)

private theorem fields_take {source : List Byte} {size : Nat}
    (enough : size ≤ source.length) (fields : List EDSL.ELF.FunctionWindow.Field)
    (inside : ∀ field ∈ fields, field.offset + field.width ≤ size) :
    gccSymbolFields source fields = gccSymbolFields (source.take size) fields := by
  unfoldGccSymbolFields
  revert inside
  induction fields with
  | nil => intro _; rfl
  | cons first rest ih =>
    intro inside
    simp only [List.all_cons]
    rw [readNat_take (inside first (by simp)) enough]
    exact congrArg _ (ih (fun field member => inside field (List.mem_cons_of_mem first member)))

private theorem tableFields_take {file : List Byte} {base size : Nat}
    (enough : base + size ≤ file.length) (rows : List (List EDSL.ELF.FunctionWindow.Field))
    (inside : ∀ fields ∈ rows, ∀ field ∈ fields, field.offset + field.width ≤ size) :
    gccTableFields file base rows =
      rows.all (fun fields => gccSymbolFields ((file.drop base).take size) fields) := by
  unfoldGccTableFields
  have baseBound : base ≤ file.length := by omega
  simp only [baseBound, decide_true, Bool.true_and]
  have sourceBound : size ≤ (file.drop base).length := by
    rw [List.length_drop]
    omega
  revert inside
  induction rows with
  | nil => intro _; rfl
  | cons first rest ih =>
    intro inside
    simp only [List.all_cons]
    rw [fields_take sourceBound first (inside first (by simp))]
    exact congrArg _ (ih (fun fields member => inside fields (List.mem_cons_of_mem first member)))


private theorem readNat_append (leading suffix : List Byte) (offset width : Nat) :
    EDSL.ELF.readNat (leading ++ suffix) (leading.length + offset) width =
      EDSL.ELF.readNat suffix offset width := by
  simp only [EDSL.ELF.readNat, List.length_append, Nat.add_assoc,
    Nat.add_le_add_iff_left, List.drop_length_add_append]

private theorem symbolFields_append (leading suffix : List Byte) (symbol : Symbol) :
    gccSymbolFields (leading ++ suffix) (symbol.fields leading.length) =
      gccSymbolFields suffix (symbol.fields 0) := by
  unfoldGccSymbolFields
  simp only [Symbol.fields, List.all_cons, List.all_nil, Nat.zero_add]
  have first := readNat_append leading suffix 0 4
  simp only [Nat.add_zero] at first
  rw [first]
  simp only [readNat_append]

private theorem sectionFields_append (leading suffix : List Byte) (sh : Section) :
    gccSymbolFields (leading ++ suffix) (sh.fields leading.length) =
      gccSymbolFields suffix (sh.fields 0) := by
  unfoldGccSymbolFields
  simp only [Section.fields, List.all_cons, List.all_nil, Nat.zero_add]
  have first := readNat_append leading suffix 0 4
  simp only [Nat.add_zero] at first
  rw [first]
  simp only [readNat_append]

private theorem symbolFields_local (symbol : Symbol) (bytes suffix : List Byte)
    (length : bytes.length = 24) :
    gccSymbolFields (bytes ++ suffix) (symbol.fields 0) =
      gccSymbolFields bytes (symbol.fields 0) := by
  have enough : 24 ≤ (bytes ++ suffix).length := by simp [length]
  rw [fields_take enough (symbol.fields 0) (by simp [Symbol.fields])]
  rw [List.take_left' length]

private theorem sectionFields_local (sh : Section) (bytes suffix : List Byte)
    (length : bytes.length = 64) :
    gccSymbolFields (bytes ++ suffix) (sh.fields 0) =
      gccSymbolFields bytes (sh.fields 0) := by
  have enough : 64 ≤ (bytes ++ suffix).length := by simp [length]
  rw [fields_take enough (sh.fields 0) (by simp [Section.fields])]
  rw [List.take_left' length]

private def normalizedRows {α : Type} (fields : α → Nat → List EDSL.ELF.FunctionWindow.Field) :
    List α → List (List Byte) → Bool
  | [], [] => true
  | row :: rows, bytes :: sources =>
    gccSymbolFields bytes (fields row 0) && normalizedRows fields rows sources
  | _, _ => false

private theorem rows_normalized {α : Type}
    (fields : α → Nat → List EDSL.ELF.FunctionWindow.Field) (width : Nat)
    (append : ∀ leading suffix row,
      gccSymbolFields (leading ++ suffix) (fields row leading.length) =
        gccSymbolFields suffix (fields row 0))
    (locality : ∀ row bytes suffix, bytes.length = width →
      gccSymbolFields (bytes ++ suffix) (fields row 0) =
        gccSymbolFields bytes (fields row 0))
    (rows : List α) (sources : List (List Byte))
    (counts : rows.length = sources.length)
    (lengths : ∀ bytes ∈ sources, bytes.length = width)
    (index : Nat) (leading : List Byte) (prefixLength : leading.length = index * width) :
    (rows.zipIdx index).all (fun pair =>
      gccSymbolFields (leading ++ sources.flatten) (fields pair.1 (pair.2 * width))) =
        normalizedRows fields rows sources := by
  induction rows generalizing sources index leading with
  | nil =>
    cases sources with
    | nil => rfl
    | cons bytes rest => simp at counts
  | cons row rows ih =>
    cases sources with
    | nil => simp at counts
    | cons bytes sources =>
      have headLength : bytes.length = width := lengths bytes (by simp)
      have tailCounts : rows.length = sources.length := by simpa using counts
      have tailLengths : ∀ bytes ∈ sources, bytes.length = width :=
        fun bytes member => lengths bytes (List.mem_cons_of_mem _ member)
      have nextLength : (leading ++ bytes).length = (index + 1) * width := by
        rw [List.length_append, prefixLength, headLength, Nat.add_mul, Nat.one_mul]
      simp only [List.zipIdx_cons, List.all_cons, List.flatten_cons, normalizedRows]
      have head : gccSymbolFields (leading ++ (bytes ++ sources.flatten))
          (fields row (index * width)) = gccSymbolFields bytes (fields row 0) := by
        rw [← prefixLength, append, locality row bytes sources.flatten headLength]
      rw [head]
      have tail := ih sources tailCounts tailLengths (index + 1) (leading ++ bytes) nextLength
      exact congrArg _ (by simpa only [List.append_assoc] using tail)

