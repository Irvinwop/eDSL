      symbols27.strings.bytes := by
  have offset : symbols27.strings.sh.offset = 36576 := rfl
  rw [offset, staticStringLength, fileDrop36576]
  exact beq_iff_eq.mp (by decide +kernel)

private theorem sectionNamesSource :
    (file.drop metadata.names.sh.offset).take metadata.names.bytes.length = metadata.names.bytes := by
  have offset : metadata.names.sh.offset = 38821 := rfl
  rw [offset, sectionStringLength, fileDrop38821]
  exact beq_iff_eq.mp (by decide +kernel)

private def symbolTableCheck (symbols : Symbols) : Bool :=
  decide (symbols.Shape metadata.sections) &&
  decide ((file.drop symbols.strings.sh.offset).take symbols.strings.bytes.length =
    symbols.strings.bytes) &&
  gccTableFields file symbols.sh.offset
    (symbols.rows.zipIdx.map fun pair => pair.1.fields (pair.2 * 24))

private theorem dynamicSymbolsAccepted : symbolTableCheck symbols05 = true := by
  unfold symbolTableCheck
  have shape : decide (symbols05.Shape metadata.sections) = true := decide_eq_true_eq.mpr dynamicShapeAccepted
  have strings : decide ((file.drop symbols05.strings.sh.offset).take symbols05.strings.bytes.length =
      symbols05.strings.bytes) = true := decide_eq_true_eq.mpr dynamicStringsSource
  have offset : symbols05.sh.offset = 944 := rfl
  rw [shape, strings, offset, dynamicFieldsAccepted]
  rfl
#print axioms dynamicSymbolsAccepted

private theorem staticSymbolsAccepted : symbolTableCheck symbols27 = true := by
  unfold symbolTableCheck
  have shape : decide (symbols27.Shape metadata.sections) = true := decide_eq_true_eq.mpr staticShapeAccepted
  have strings : decide ((file.drop symbols27.strings.sh.offset).take symbols27.strings.bytes.length =
      symbols27.strings.bytes) = true := decide_eq_true_eq.mpr staticStringsSource
  have offset : symbols27.sh.offset = 33048 := rfl
  rw [shape, strings, offset, staticFieldsAccepted]
  rfl
#print axioms staticSymbolsAccepted

private theorem metadataTablesAccepted : metadata.tables.all (fun symbols =>
    decide (symbols.Shape metadata.sections) &&
    decide ((file.drop symbols.strings.sh.offset).take symbols.strings.bytes.length =
      symbols.strings.bytes) &&
    gccTableFields file symbols.sh.offset
      (symbols.rows.zipIdx.map fun pair => pair.1.fields (pair.2 * 24))) = true := by
  have tables : metadata.tables = [symbols05, symbols27] := rfl
  rw [tables, List.all_cons, List.all_cons, List.all_nil]
  have dynamic := dynamicSymbolsAccepted
  have static := staticSymbolsAccepted
  unfold symbolTableCheck at dynamic static
  rw [dynamic, static]
  rfl
#print axioms metadataTablesAccepted

theorem metadataAccepted : checkMetadata file table.header metadata = true := by
  unfold checkMetadata
  have sectionOffset : table.header.sectionOffset = 39096 := rfl
  have strings : decide ((file.drop metadata.names.sh.offset).take metadata.names.bytes.length =
      metadata.names.bytes) = true := decide_eq_true_eq.mpr sectionNamesSource
  rw [sectionOffset, sectionFieldsAccepted, metadataTablesAccepted, strings]
  simp only [fileLength]
  decide +kernel
#print axioms metadataAccepted

local macro "unfoldGccLayoutFields" : tactic => do
  let identifier := Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionWindow 0 ++
    `EDSL.ELF.FunctionWindow.checkFields)
  `(tactic| unfold $identifier:ident)

theorem layoutAccepted : EDSL.ELF.FunctionWindow.checkLayout file table = true := by
  unfold EDSL.ELF.FunctionWindow.checkLayout
  unfoldGccLayoutFields
  unfold EDSL.ELF.readNat EDSL.ELF.valid
  simp only [fileLength]
  decide +kernel
#print axioms layoutAccepted

-- Index normalization uses the original file chunks and the proved uniform
-- prefix lengths; no runtime byte lookup is replaced by host extraction.
private theorem chunkPrefixLength (i : Nat) (bounded : i ≤ 320) :
    (chunks.take i).flatten.length = i * 128 := by
  rw [List.length_flatten, List.map_take, chunkLengths]
  rw [List.take_append_of_le_length (by simpa only [List.length_replicate] using bounded)]
  simp only [List.take_replicate, Nat.min_eq_left bounded, List.sum_replicate_nat]

private theorem fileDropAt (n : Nat) (bounded : n ≤ 41016) :
    file.drop n = ((chunks.drop (n / 128)).flatten).drop (n % 128) := by
  let front := (chunks.take (n / 128)).flatten
  let back := (chunks.drop (n / 128)).flatten
  have split : file = front ++ back := by
    calc
      file = chunks.flatten := by rfl
      _ = (chunks.take (n / 128) ++ chunks.drop (n / 128)).flatten :=
        congrArg List.flatten (List.take_append_drop (n / 128) chunks).symm
      _ = _ := List.flatten_append
  have length : front.length = n / 128 * 128 :=
    chunkPrefixLength (n / 128) (by omega)
  have index : n = front.length + n % 128 := by rw [length]; omega
  calc
    file.drop n = (front ++ back).drop n := congrArg (List.drop n) split
    _ = (front ++ back).drop (front.length + n % 128) :=
      congrArg (fun k => (front ++ back).drop k) index
    _ = back.drop (n % 128) := List.drop_length_add_append _

private theorem fileGetElem (n : Nat) :
    file[n]? = if n < 41016 then
      (((chunks.drop (n / 128)).flatten).drop (n % 128))[0]? else none := by
  by_cases inside : n < 41016
  · rw [ite_eq_left inside]
    have dropped := congrArg (fun source : List Byte => source[0]?)
      (fileDropAt n (by omega))
    simpa only [List.getElem?_drop, Nat.add_zero] using dropped
  · rw [ite_eq_right inside]
    exact List.getElem?_eq_none (by rw [fileLength]; omega)
#print axioms fileGetElem

theorem minAccepted : check file table metadata minName minFunction minBytes = true := by
  unfold EDSL.ELF.FunctionSymbol.check
  rw [metadataAccepted]
  unfold EDSL.ELF.FunctionWindow.check
  have offset : minFunction.window.offset = 11600 := rfl
  rw [layoutAccepted, offset, fileDrop11600]
  simp only [fileLength]
  simp only [EDSL.ELF.checkCode, EDSL.X86.fetchByte, EDSL.OS.AddressSpace.toMemory,
    EDSL.ELF.install, EDSL.ELF.segmentCell, fileGetElem]
  decide +kernel
#print axioms minAccepted

theorem maxAccepted : check file table metadata maxName maxFunction maxBytes = true := by
  unfold EDSL.ELF.FunctionSymbol.check
  rw [metadataAccepted]
  unfold EDSL.ELF.FunctionWindow.check
  have offset : maxFunction.window.offset = 11616 := rfl
  rw [layoutAccepted, offset, fileDrop11616]
  simp only [fileLength]
  simp only [EDSL.ELF.checkCode, EDSL.X86.fetchByte, EDSL.OS.AddressSpace.toMemory,
    EDSL.ELF.install, EDSL.ELF.segmentCell, fileGetElem]
  decide +kernel
#print axioms maxAccepted


/-- Complete section/symbol/string evidence against the same literal file. -/
theorem metadataChecked : EDSL.ELF.FunctionSymbol.CheckedMetadata file table.header metadata :=
  EDSL.ELF.FunctionSymbol.checkMetadata_sound metadataAccepted

/-- Complete ELF/program-header layout and validated executable LOADs. -/
theorem layoutChecked : EDSL.ELF.FunctionWindow.Layout file table :=
  EDSL.ELF.FunctionWindow.checkLayout_sound layoutAccepted

#print axioms metadataChecked
#print axioms layoutChecked

/-- A tail of the original literal file, normalized through its existing chunks.
The public term keeps downstream proofs independent of private helper names. -/
def chunkTail (offset : Nat) : List Byte :=
  ((chunks.drop (offset / 128)).flatten).drop (offset % 128)

/-- Normalize a bounded file tail without traversing every preceding byte. -/
theorem fileDropChunks (offset : Nat) (bounded : offset ≤ 41016) :
    file.drop offset = chunkTail offset :=
  fileDropAt offset bounded

/-- Normalize an optional byte lookup, including the out-of-file case. -/
theorem fileByteChunks (offset : Nat) :
    file[offset]? = if offset < 41016 then (chunkTail offset)[0]? else none :=
  fileGetElem offset

#print axioms fileDropChunks
#print axioms fileByteChunks
end EDSL.Corpus.V1.GCC
