-- Algebraic normalization of reads from the exact original complete file.
theorem chunkPrefixLength (i : Nat) (bounded : i ≤ 345) :
    (chunks.take i).flatten.length = i * 128 := by
  rw [List.length_flatten, List.map_take, chunkLengths]
  rw [List.take_append_of_le_length (by simpa only [List.length_replicate] using bounded)]
  simp only [List.take_replicate, Nat.min_eq_left bounded, List.sum_replicate_nat]
#print axioms chunkPrefixLength

theorem fileDropAt (n : Nat) (bounded : n ≤ 44240) :
    file.drop n = ((chunks.drop (n / 128)).flatten).drop (n % 128) := by
  let front := (chunks.take (n / 128)).flatten
  let back := (chunks.drop (n / 128)).flatten
  have split : file = front ++ back := by
    calc
      file = chunks.flatten := by rfl
      _ = (chunks.take (n / 128) ++ chunks.drop (n / 128)).flatten :=
        congrArg List.flatten (List.take_append_drop (n / 128) chunks).symm
      _ = _ := List.flatten_append
  have length : front.length = n / 128 * 128 :=
    chunkPrefixLength (n / 128) (by omega)
  have index : n = front.length + n % 128 := by
    rw [length]
    omega
  calc
    file.drop n = (front ++ back).drop n := congrArg (List.drop n) split
    _ = (front ++ back).drop (front.length + n % 128) :=
      congrArg (fun k => (front ++ back).drop k) index
    _ = back.drop (n % 128) := List.drop_length_add_append _
#print axioms fileDropAt

theorem readFileSlice (base : Nat) (bounded : base ≤ 44240) (offset width : Nat) :
    EDSL.ELF.readNat (file.drop base) offset width =
      if offset + width ≤ 44240 - base then
        .ok (((((chunks.drop ((base + offset) / 128)).flatten).drop
          ((base + offset) % 128)).take width).foldr
          (fun byte rest => byte.toNat + rest * 256) 0)
      else .error EDSL.ELF.Error.truncated := by
  unfold EDSL.ELF.readNat
  rw [List.length_drop, fileLength]
  split
  · rename_i inside
    rw [List.drop_drop, fileDropAt (base + offset) (by omega)]
  · rfl
#print axioms readFileSlice

-- These equations are about the exact frozen production checker constants.
-- Numeric private-name components must be constructed as Name.num, not strings.
-- These macros only name exact imported constants; they supply no proof result.
macro "tableFields" : term => do
  let exactName := Lean.Name.num `_private.EDSL.ELF.FunctionSymbol 0 ++
    `EDSL.ELF.FunctionSymbol.checkTableFields
  pure (Lean.mkIdent exactName)

macro "unfoldFrozenTable" : tactic => do
  let identifier := Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionSymbol 0 ++
    `EDSL.ELF.FunctionSymbol.checkTableFields)
  `(tactic| unfold $identifier:ident)

macro "unfoldFrozenSymbolFields" : tactic => do
  let identifier := Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionSymbol 0 ++
    `EDSL.ELF.FunctionSymbol.checkFields)
  `(tactic| unfold $identifier:ident)

macro "unfoldFrozenLayoutFields" : tactic => do
  let identifier := Lean.mkIdent (Lean.Name.num `_private.EDSL.ELF.FunctionWindow 0 ++
    `EDSL.ELF.FunctionWindow.checkFields)
  `(tactic| unfold $identifier:ident)

