import EDSL.OS.TSO64.EffectSimulation.Mixed.RankedLocal
import EDSL.OS.TSO64.EffectSimulation.Mixed.Cohort
import EDSL.OS.TSO64.EffectSimulation.Mixed.RankedPotential
import EDSL.OS.TSO64.EffectSimulation.Mixed.ChoiceTrace

set_option autoImplicit false
set_option warningAsError true
set_option maxHeartbeats 300000
set_option maxRecDepth 128

/-!
Finite completion from present every-node invariants and independent local
ranks. Every scheduler slot has its own descriptor, local rules and rank laws
under the same production profile and family. Ghosts are explicit dependent
functions; all local traces retain those very ghosts and their entire logs.

A running ghost enables one actual issue with the requested AF choice. Every
subject advances through that same checked step. Its own measure strictly
decreases and every other measure is nonincreasing, so the finite sum drops.
The existing caller-only cohort law supplies current quiescence and actual
retirement classification; its separately existential successor ghosts are
not used as the ranked successors. Strong induction constructs a successful
finite suffix, including for the empty slot universe with supplied validity.

All returned phases are derived from the exact done responses and their saved
current workers. AF choices are per-thread and start at arbitrary offsets.
The action bound is an issue upper bound, not a minimum, hardware cost or
fairness claim. The imported target, OS authority, lifetime, synchronization,
translation and protected-loan contracts remain explicit in the admissions
and rules. No native refinement, source preservation, final counter value,
or whole-corpus admission is established here.
-/

namespace EDSL.OS.TSO64.EffectSimulation.Mixed
open X86

/-- One ranked subject per actual scheduler slot, with source caller policy.
Annotations are generated from these rules rather than supplied separately. -/
structure RankedCohort (n : Nat) (profile : Profile) (family : RMWFamily) where
  descriptor : Fin n → Descriptor
  post : Fin n → Assertion
  rules : ∀ i : Fin n, LocalRules (descriptor i) (post i)
  rankLaws : ∀ i : Fin n, RankLaws (rules i)
  profile_eq : ∀ i : Fin n, (descriptor i).profile = profile
  family_eq : ∀ i : Fin n, (descriptor i).family = family
  tid_eq : ∀ i : Fin n, (descriptor i).tid = i.val
  callerPolicy : ∀ (i : Fin n) (state : S),
    (descriptor i).policy state = authorityCallerPolicy (descriptor i) state

namespace RankedCohort

variable {n : Nat} {profile : Profile} {family : RMWFamily}

/-- Forget ranks using exactly the annotations generated by the local rules. -/
def toCohort (cohort : RankedCohort n profile family) : Cohort (Fin n) profile family where
  descriptor := cohort.descriptor
  post := cohort.post
  annotations := fun i => (cohort.rules i).annotations
  profile_eq := cohort.profile_eq
  family_eq := cohort.family_eq
  callerPolicy := cohort.callerPolicy

/-- Explicit ghosts with their respective graphs, assertions and full logs. -/
def Ghosts (cohort : RankedCohort n profile family) (initial : S) : Type :=
  ∀ i : Fin n, Ghost (cohort.descriptor i) initial (cohort.post i)

/-- Every-node Inv and the generated residual/response on these same ghosts. -/
def Current (cohort : RankedCohort n profile family) {initial : S}
    (state : S) (ghosts : cohort.Ghosts initial) : Prop :=
  ∀ i : Fin n, (cohort.rules i).LocalRelated state (ghosts i)

/-- Exact per-ghost measures, summed over the complete finite slot universe. -/
def potential (cohort : RankedCohort n profile family) {initial : S}
    (ghosts : cohort.Ghosts initial) : Nat :=
  RankedPotential.indexedSum (fun i => (ghosts i).measure (cohort.rankLaws i).rank)

/-- Each explicit ghost has retained an actual historical RET response. -/
def AllDone (cohort : RankedCohort n profile family) {initial : S}
    (ghosts : cohort.Ghosts initial) : Prop :=
  ∀ i : Fin n, ∃ response : Response (cohort.descriptor i) initial (cohort.post i),
    (ghosts i).control = .done response

/-- All subjects' enriched transitions through one common scheduler position. -/
def Step (cohort : RankedCohort n profile family) {initial : S}
    (before : cohort.Ghosts initial) (action : Action) (seen : O)
    (after : cohort.Ghosts initial) : Prop :=
  ∀ i : Fin n, (cohort.rules i).LocalStep (before i) action seen (after i)

/-- Current local witnesses supply ordinary cohort admission without changing
or identifying any ghosts. -/
theorem current_toCohort (cohort : RankedCohort n profile family)
    {initial state : S} {ghosts : cohort.Ghosts initial}
    (current : cohort.Current state ghosts) : cohort.toCohort.Current initial state := by
  intro i
  exact ⟨ghosts i, (current i).1⟩

/-- The actual list length and slot equation cover every physical worker. -/
theorem covers (cohort : RankedCohort n profile family) {state : S}
    (count : state.workers.length = n) : cohort.toCohort.Covers state := by
  intro tid worker live
  have bound : tid < n := by
    rw [← count]
    exact (List.getElem_of_getElem? live).1
  exact ⟨⟨tid, bound⟩, cohort.tid_eq ⟨tid, bound⟩⟩

/-- A collective lifted trace projects to each subject's exact enriched trace. -/
theorem localTrace (cohort : RankedCohort n profile family)
    {initial : S} {before after : cohort.Ghosts initial}
    {actions : List Action} {observations : List O}
    (trace : LiftTrace cohort.Step before actions observations after) (i : Fin n) :
    LiftTrace (cohort.rules i).LocalStep (before i) actions observations (after i) := by
  induction trace with
  | nil => exact .nil
  | cons head _tail ih => exact .cons (head i) ih

/-- Absence of all-done control gives a present running ghost, not a premise
about any future execution or physical returned state. -/
theorem running_of_not_done (cohort : RankedCohort n profile family)
    {initial : S} {ghosts : cohort.Ghosts initial} (notDone : ¬ cohort.AllDone ghosts) :
    ∃ (i : Fin n) (node : (cohort.descriptor i).graph.Index) (fuel : Nat),
      (ghosts i).control = .running node fuel := by
  classical
  apply Classical.byContradiction
  intro none
  apply notDone
  intro i
  cases control : (ghosts i).control with
  | running node fuel => exact False.elim (none ⟨i, node, fuel, control⟩)
  | done response => exact ⟨response, rfl⟩

/-- Done supplies an actual currently returned worker through SavedFrame.
The current slot universe then accounts for every member of the actual list. -/
theorem returned_of_done (cohort : RankedCohort n profile family)
    {initial state : S} {ghosts : cohort.Ghosts initial}
    (count : state.workers.length = n) (current : cohort.Current state ghosts)
    (done : cohort.AllDone ghosts) :
    ∀ worker ∈ state.workers, worker.phase = .returned := by
  intro worker member
  obtain ⟨tid, live⟩ := List.mem_iff_getElem?.mp member
  have bound : tid < n := by
    rw [← count]
    exact (List.getElem_of_getElem? live).1
  let i : Fin n := ⟨tid, bound⟩
  obtain ⟨response, control⟩ := done i
  have retained : Done (cohort.descriptor i) initial (cohort.post i) response
      (ghosts i).current (ghosts i).history := by
    have atControl := (current i).1.2
    simpa only [control] using atControl
  obtain ⟨savedWorker, savedLive, saved⟩ := retained.saved
  have savedAt : state.workers[(cohort.descriptor i).tid]? = some savedWorker := by
    rw [(current i).1.1]
    exact savedLive
  have liveAt : state.workers[(cohort.descriptor i).tid]? = some worker := by
    simpa only [cohort.tid_eq i] using live
  have same : worker = savedWorker := Option.some.inj (liveAt.symm.trans savedAt)
  exact (congrArg Worker.phase same).trans (saved.phase.trans response.phase)

/-- Construct one requested actual issue and lift every subject through that
same step. The witnesses used in the sum each retain their own LocalStep;
the strict witness is chosen together with its own rank inequality. -/
theorem enabled_step (cohort : RankedCohort n profile family)
    {initial before : S} {ghosts : cohort.Ghosts initial}
    (valid : WellFormed before profile) (count : before.workers.length = n)
    (current : cohort.Current before ghosts) (empty : Quiescent before)
    (i : Fin n) {node : (cohort.descriptor i).graph.Index} {fuel : Nat}
    (running : (ghosts i).control = .running node fuel) (af : Bool) :
    ∃ (after : S) (seen : O) (next : cohort.Ghosts initial),
      TSO64.step before (.issue i.val af) profile family = .ok (after, seen) ∧
      WellFormed after profile ∧ after.workers.length = n ∧
      Quiescent after ∧ cohort.toCohort.Covers after ∧ cohort.Current after next ∧
      cohort.Step ghosts (.issue i.val af) seen next ∧
      cohort.toCohort.Retires (.issue i.val af) seen ∧
      cohort.potential next < cohort.potential ghosts := by
  classical
  have ownCurrent : (cohort.rules i).LocalRelated (ghosts i).current (ghosts i) := by
    simpa only [(current i).1.1] using current i
  have ownEmpty : Quiescent (ghosts i).current := by
    simpa only [(current i).1.1] using empty
  obtain ⟨after, seen, ownNext, ownActual, ownRelated, ownStep, ownStrict⟩ :=
    (cohort.rankLaws i).own_enabled_from_current ownCurrent running ownEmpty af
  have actual : TSO64.step before (.issue i.val af) profile family = .ok (after, seen) := by
    simpa only [← (current i).1.1, cohort.tid_eq i, cohort.profile_eq i,
      cohort.family_eq i] using ownActual
  have successors : ∀ j : Fin n,
      ∃ next : Ghost (cohort.descriptor j) initial (cohort.post j),
        (cohort.rules j).LocalRelated after next ∧
        (cohort.rules j).LocalStep (ghosts j) (.issue i.val af) seen next ∧
        next.measure (cohort.rankLaws j).rank ≤ (ghosts j).measure (cohort.rankLaws j).rank ∧
        (j = i → next.measure (cohort.rankLaws j).rank <
          (ghosts j).measure (cohort.rankLaws j).rank) := by
    intro j
    by_cases same : j = i
    · subst j
      refine ⟨ownNext, ownRelated, ?_, Nat.le_of_lt ownStrict, fun _ => ownStrict⟩
      simpa only [cohort.tid_eq i] using ownStep
    · have selected : TSO64.step before (.issue i.val af)
          (cohort.descriptor j).profile (cohort.descriptor j).family = .ok (after, seen) := by
        simpa only [cohort.profile_eq j, cohort.family_eq j] using actual
      obtain ⟨next, advanced, nextRelated⟩ :=
        (cohort.rules j).localSimulation.lift (current j).1.frame.wellFormed (current j) selected
      exact ⟨next, nextRelated, advanced,
        (cohort.rankLaws j).measure_advance advanced.1 advanced.2.1,
        fun equal => False.elim (same equal)⟩
  let next : cohort.Ghosts initial := fun j => Classical.choose (successors j)
  have nextCurrent : cohort.Current after next :=
    fun j => (Classical.choose_spec (successors j)).1
  have advanced : cohort.Step ghosts (.issue i.val af) seen next :=
    fun j => (Classical.choose_spec (successors j)).2.1
  have smaller : cohort.potential next < cohort.potential ghosts := by
    exact RankedPotential.indexedSum_lt
      (fun j => (Classical.choose_spec (successors j)).2.2.1)
      ⟨i, (Classical.choose_spec (successors i)).2.2.2 rfl⟩
  obtain ⟨afterEmpty, afterCovered, _otherCurrent, retiring⟩ :=
    cohort.toCohort.step_closed (cohort.covers count) (cohort.current_toCohort current) empty actual
  have singletonRun : TSO64.schedule before [.issue i.val af] profile family =
      .ok (after, [seen]) := by
    simp only [TSO64.schedule, actual, ok_bind, pure_ok]
  have afterCount : after.workers.length = n :=
    (ScheduleTrace.workers_length singletonRun).trans count
  exact ⟨after, seen, next, actual, step_wellFormed valid actual, afterCount,
    afterEmpty, afterCovered, nextCurrent, advanced, retiring, smaller⟩

/-- A constructed finite suffix, including actual execution, current local
invariants, actual returned workers, retirement labels and per-thread choices.
The length bound counts issued actions and is only an upper bound. -/
structure Suffix (cohort : RankedCohort n profile family) {initial before : S}
    (ghosts : cohort.Ghosts initial) (choices : Nat → Nat → Bool) (offset : Nat → Nat) where
  actions : List Action
  observations : List O
  final : S
  finalGhosts : cohort.Ghosts initial
  actual : TSO64.schedule before actions profile family = .ok (final, observations)
  finalWellFormed : WellFormed final profile
  finalWorkers : final.workers.length = n
  quiescent : Quiescent final
  finalCurrent : cohort.Current final finalGhosts
  allDone : cohort.AllDone finalGhosts
  returned : ∀ worker ∈ final.workers, worker.phase = .returned
  lifted : LiftTrace cohort.Step ghosts actions observations finalGhosts
  realRetirementTrace : cohort.toCohort.RetirementTrace actions observations
  chosen : ChoiceTrace.ChosenFrom choices offset actions
  issue_upper_bound : actions.length ≤ cohort.potential ghosts

/-- Strong induction on the finite exact-ghost potential. Offsets are
generalized at every recursive call, including repeated issues of a thread. -/
private theorem complete_at_potential (cohort : RankedCohort n profile family)
    (initial : S) (choices : Nat → Nat → Bool) :
    ∀ amount : Nat, ∀ {before : S} (ghosts : cohort.Ghosts initial) (offset : Nat → Nat),
      cohort.potential ghosts = amount →
      WellFormed before profile → before.workers.length = n →
      cohort.Current before ghosts → Quiescent before →
      Nonempty (cohort.Suffix (before := before) ghosts choices offset) := by
  classical
  intro amount
  induction amount using Nat.strongRecOn with
  | ind amount ih =>
    intro before ghosts offset atPotential valid count current empty
    by_cases done : cohort.AllDone ghosts
    · exact ⟨{
        actions := []
        observations := []
        final := before
        finalGhosts := ghosts
        actual := rfl
        finalWellFormed := valid
        finalWorkers := count
        quiescent := empty
        finalCurrent := current
        allDone := done
        returned := cohort.returned_of_done count current done
        lifted := .nil
        realRetirementTrace := .nil
        chosen := ChoiceTrace.chosen_nil choices offset
        issue_upper_bound := Nat.zero_le _ }⟩
    · obtain ⟨i, node, fuel, running⟩ := cohort.running_of_not_done done
      obtain ⟨after, seen, next, actual, afterValid, afterCount, afterEmpty,
        _afterCovered, nextCurrent, advanced, retiring, smaller⟩ :=
        cohort.enabled_step valid count current empty i running (choices i.val (offset i.val))
      have below : cohort.potential next < amount := by
        simpa only [atPotential] using smaller
      obtain ⟨rest⟩ := ih (cohort.potential next) below next
        (ChoiceTrace.bump offset i.val) rfl afterValid afterCount nextCurrent afterEmpty
      refine ⟨{
        actions := .issue i.val (choices i.val (offset i.val)) :: rest.actions
        observations := seen :: rest.observations
        final := rest.final
        finalGhosts := rest.finalGhosts
        actual := ?_
        finalWellFormed := rest.finalWellFormed
        finalWorkers := rest.finalWorkers
        quiescent := rest.quiescent
        finalCurrent := rest.finalCurrent
        allDone := rest.allDone
        returned := rest.returned
        lifted := .cons advanced rest.lifted
        realRetirementTrace := .cons retiring rest.realRetirementTrace
        chosen := ChoiceTrace.chosen_cons rest.chosen
        issue_upper_bound := ?_ }⟩
      · simp only [TSO64.schedule, actual, ok_bind, rest.actual, pure_ok]
      · exact Nat.le_trans (Nat.succ_le_succ rest.issue_upper_bound) smaller

/-- Present validity, the actual slot universe, explicit current ghosts and
empty queues construct a successful finite completion for arbitrary offsets.
There is no future-success, return, count-result or value premise. -/
theorem complete_from_current (cohort : RankedCohort n profile family)
    {initial before : S} {ghosts : cohort.Ghosts initial}
    (valid : WellFormed before profile) (count : before.workers.length = n)
    (current : cohort.Current before ghosts) (empty : Quiescent before)
    (choices : Nat → Nat → Bool) (offset : Nat → Nat) :
    Nonempty (cohort.Suffix (before := before) ghosts choices offset) :=
  complete_at_potential cohort initial choices (cohort.potential ghosts) ghosts offset
    rfl valid count current empty

/-- Starting each thread's suffix choices at zero gives suffix-local
ChosenIssues. Initial validity remains explicit even when n = 0. -/
theorem complete (cohort : RankedCohort n profile family)
    {initial before : S} {ghosts : cohort.Ghosts initial}
    (valid : WellFormed before profile) (count : before.workers.length = n)
    (current : cohort.Current before ghosts) (empty : Quiescent before)
    (choices : Nat → Nat → Bool) :
    Nonempty (cohort.Suffix (before := before) ghosts choices (fun _ => 0)) :=
  cohort.complete_from_current valid count current empty choices (fun _ => 0)

/-- The zero-offset constructed suffix satisfies the shared OS choice API. -/
theorem Suffix.chosenIssues {cohort : RankedCohort n profile family}
    {initial before : S} {ghosts : cohort.Ghosts initial} {choices : Nat → Nat → Bool}
    (suffix : cohort.Suffix (before := before) ghosts choices (fun _ => 0)) :
    ChoiceTrace.ChosenIssues choices suffix.actions := suffix.chosen

/-- Full histories of the same final ghosts retain both original projections
after the starting histories and their authenticated same-family origins. -/
theorem Suffix.histories {cohort : RankedCohort n profile family}
    {initial before : S} {ghosts : cohort.Ghosts initial}
    {choices : Nat → Nat → Bool} {offset : Nat → Nat}
    (suffix : cohort.Suffix (before := before) ghosts choices offset) (i : Fin n) :
    OriginTrace (cohort.descriptor i).profile initial (suffix.finalGhosts i).history
        suffix.final (cohort.descriptor i).family ∧
      (suffix.finalGhosts i).history.map Tick.action =
        (ghosts i).history.map Tick.action ++ suffix.actions ∧
      (suffix.finalGhosts i).history.map (fun tick => tick.result.2) =
        (ghosts i).history.map (fun tick => tick.result.2) ++ suffix.observations := by
  have subjectTrace := cohort.localTrace suffix.lifted i
  have logs := liftTrace_logs ((cohort.rules i).localTrace_forget subjectTrace)
  exact ⟨(suffix.finalCurrent i).1.authentic, logs⟩

